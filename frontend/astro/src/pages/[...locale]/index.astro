---
import Layout from "@/layouts/Layout.astro";
import Stippled from "@/components/Stippled.astro";
import WorksheetThumb from "@/components/WorksheetThumb.astro";
import { WORKSHEET_SECTIONS } from "@/lib/worksheet-info";
import { getWorksheetInfo } from "@/lib/worksheet-content";
import { MathText } from "@/components/MathText";
import { t } from "@/i18n";
import {
    localeFromParam,
    localeStaticParams,
    localizePath,
} from "@/i18n/locales";

export function getStaticPaths() {
    return localeStaticParams().map((params) => ({ params }));
}

const locale = localeFromParam(Astro.params.locale);
const ui = t(locale);
const WORKSHEET_INFO = await getWorksheetInfo(locale);
---

<Layout
    title={ui.meta.homeTitle}
    description={ui.meta.homeDescription}
    locale={locale}
>
    <div class="p-4 md:p-8 max-w-6xl mx-auto">
        <h1 class="text-3xl font-semibold mb-4">{ui.home.heading}</h1>
        <p class="text-lg text-muted-foreground max-w-2xl mb-10">
            {ui.home.intro}
        </p>

        <!--
          Sectioned layout: one heading + card grid per topic cluster.
          Section order is curriculum-progression (arithmetic → drills →
          long-form → fractions → pre-algebra); within each, order
          matches classroom sequencing. The card grid reuses the same
          shadcn card tokens as the per-type pages for visual cohesion.
          Sections stack vertically on mobile — no extra breakpoints
          needed for the section structure itself.
        -->
        <div class="space-y-10">
            {
                /* First section (Arithmetic) renders eagerly so its
                   thumbs are inlined into the HTML and visible without
                   a network roundtrip. Below-fold sections pass
                   `lazy` so each thumb becomes <img loading="lazy">. */
                WORKSHEET_SECTIONS.map((section, sectionIndex) => (
                    <section>
                        <h2 class="text-xl font-semibold mb-4 pb-1 border-b border-pencil-no-2">
                            {ui.home.sections[section.id]}
                        </h2>
                        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                            {section.kinds.map((kind) => {
                                const info = WORKSHEET_INFO[kind];
                                return (
                                    <li>
                                        <Stippled
                                            as="a"
                                            href={localizePath(
                                                `/worksheets/${kind}/`,
                                                locale,
                                            )}
                                            class="flex gap-3 h-full p-5 rounded-xl border bg-card text-card-foreground shadow hover:border-primary transition"
                                        >
                                            <div class="flex-1 min-w-0">
                                                <h3 class="font-semibold mb-1">
                                                    {info.title}
                                                </h3>
                                                <div class="text-sm text-muted-foreground">
                                                    <MathText
                                                        text={info.summary}
                                                    />
                                                </div>
                                            </div>
                                            <div class="flex-shrink-0 w-14 self-start text-foreground/70">
                                                <WorksheetThumb
                                                    kind={kind}
                                                    locale={locale}
                                                    lazy={sectionIndex > 0}
                                                />
                                            </div>
                                        </Stippled>
                                    </li>
                                );
                            })}
                        </ul>
                    </section>
                ))
            }
        </div>
    </div>
</Layout>
