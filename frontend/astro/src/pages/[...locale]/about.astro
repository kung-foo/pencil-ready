---
import Layout from "@/layouts/Layout.astro";
import Stippled from "@/components/Stippled.astro";
import AboutEn from "@/components/about/AboutEn.astro";
import AboutNb from "@/components/about/AboutNb.astro";
import { t } from "@/i18n";
import {
    localeFromParam,
    localeStaticParams,
    localizePath,
    type Locale,
} from "@/i18n/locales";

export function getStaticPaths() {
    return localeStaticParams().map((params) => ({ params }));
}

const locale = localeFromParam(Astro.params.locale);
const ui = t(locale);

// The prose is long-form, so each locale has its own body component;
// the card, heading, in-page nav and back link are shared here.
const BODIES: Record<Locale, typeof AboutEn> = { en: AboutEn, no: AboutNb };
const Body = BODIES[locale];

const NAV: { id: string; label: string }[] = [
    { id: "why-this-exists", label: ui.about.sections.why },
    { id: "using-the-worksheets", label: ui.about.sections.using },
    { id: "whats-inside", label: ui.about.sections.inside },
    { id: "open-source", label: ui.about.sections.openSource },
    { id: "whats-next", label: ui.about.sections.next },
    { id: "credits", label: ui.about.sections.credits },
];
---

<Layout
    title={ui.meta.aboutTitle}
    description={ui.meta.aboutDescription}
    locale={locale}
>
    <div class="p-4 md:p-8 max-w-2xl mx-auto">
        <Stippled
            as="article"
            class="rounded-xl border bg-card text-card-foreground shadow p-6 md:p-10 space-y-8"
        >
            <header class="space-y-2">
                <h1
                    class="text-3xl font-semibold pb-0 border-b-2 border-pencil-no-2"
                >
                    {ui.about.heading}
                </h1>
                <p class="text-muted-foreground text-lg">
                    {ui.about.subtitle}
                </p>
            </header>

            <nav
                aria-label={ui.about.onThisPage}
                class="text-sm text-muted-foreground"
            >
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                    {
                        NAV.map((item) => (
                            <li>
                                <a
                                    href={`#${item.id}`}
                                    class="underline underline-offset-2 hover:text-primary"
                                >
                                    {item.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <Body />

            <div class="pt-4 border-t">
                <a
                    href={localizePath("/", locale)}
                    class="inline-flex items-center gap-2 text-primary hover:underline underline-offset-4"
                >
                    {ui.about.back}
                </a>
            </div>
        </Stippled>
    </div>
</Layout>
