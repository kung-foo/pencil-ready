{
    "_comment": "Concept-level presets per worksheet kind; the 1-based position is the level id (?level=N). Read by lib/levels.ts and by the server test levels_fit_one_page_on_every_paper, which checks every preset (in every division layout) fits one page on A4 and US Letter. Labels and examples live in the i18n dictionaries. problems/cols, when given, must fit the area common to every paper (common_content_area_cm).",
    "add": [
        {
            "params": {
                "digits": "2,2",
                "carry": "none"
            }
        },
        {
            "note": "force so every problem actually exercises carrying — any would let plain no-carry sums slip in and dilute the practice.",
            "params": {
                "digits": "2,2",
                "carry": "force"
            }
        },
        {
            "params": {
                "digits": "3,3",
                "carry": "any"
            }
        }
    ],
    "subtract": [
        {
            "params": {
                "digits": "2,2",
                "borrow": "none"
            }
        },
        {
            "note": "force so the kid actually practices borrowing every problem.",
            "params": {
                "digits": "2,2",
                "borrow": "force"
            }
        },
        {
            "note": "any lets borrow-across-zero cases appear naturally — a soft intro before level 4 forces ripple every time.",
            "params": {
                "digits": "3,3",
                "borrow": "any"
            }
        },
        {
            "note": "ripple guarantees every problem chains the borrow through 2+ columns (e.g. across a 0). This is the case that typically trips kids up the most.",
            "params": {
                "digits": "3,3",
                "borrow": "ripple"
            }
        }
    ],
    "fraction-add": [
        {
            "params": {
                "relation": "same"
            }
        },
        {
            "note": "One denominator divides the other, so only one fraction gets rewritten — the step between combining numerators and finding a new common denominator.",
            "params": {
                "relation": "multiple"
            }
        },
        {
            "params": {
                "relation": "unrelated"
            }
        },
        {
            "note": "Mixed review: all three relations on one page.",
            "params": {
                "relation": "any"
            }
        }
    ],
    "fraction-subtract": [
        {
            "params": {
                "relation": "same"
            }
        },
        {
            "note": "One denominator divides the other, so only one fraction gets rewritten — the step between combining numerators and finding a new common denominator.",
            "params": {
                "relation": "multiple"
            }
        },
        {
            "params": {
                "relation": "unrelated"
            }
        },
        {
            "note": "Mixed review: all three relations on one page.",
            "params": {
                "relation": "any"
            }
        }
    ],
    "fraction-decimal-percent": [
        {
            "note": "Denominators 10 and 100 only: the fraction is the decimal read aloud (7/100 = 0.07), so this level is about place value.",
            "params": {
                "denominators": "10,100"
            }
        },
        {
            "params": {
                "denominators": "2,4,5,10,20,25,50"
            }
        },
        {
            "note": "Eighths and fortieths need three decimal places (0.125) and give half percents (12.5%); improper adds a few values between 1 and 2.",
            "params": {
                "denominators": "2,4,5,8,10,20,25,40,50",
                "improper": true
            }
        }
    ],
    "percent-of": [
        {
            "note": "10% and 50% are the anchors: divide by 10, halve. Bases up to 200 keep the arithmetic mental.",
            "params": {
                "percents": "10,50",
                "max_base": 200
            }
        },
        {
            "note": "20% is two tens, 25% a quarter, 75% three quarters, built from the level 1 anchors.",
            "params": {
                "percents": "10,20,25,50,75",
                "max_base": 400
            }
        },
        {
            "note": "Any percent of a two-digit number, with up to two decimals in the answer: a two-digit by two-digit multiplication, then dividing by 100 by moving the decimal point. Whole-number answers would force odd percents (37%) onto bases of 100, 200, … and the multiplication disappears.",
            "params": {
                "percents": "1-99",
                "max_base": 99,
                "decimals": true
            }
        }
    ],
    "factor-pairs": [
        {
            "note": "Numbers 10-30 (the top two thirds of the range): up to four pairs (24, 30).",
            "params": {
                "max_number": 30
            }
        },
        {
            "note": "Numbers 20-60: up to six pairs (60).",
            "params": {
                "max_number": 60
            }
        },
        {
            "note": "Numbers 33-100, with primes mixed in: a prime has only the pair 1 x p.",
            "params": {
                "max_number": 100,
                "primes": true
            }
        }
    ],
    "prime-factors": [
        {
            "note": "Composites 10-30: two or three primes, a tree of two levels.",
            "params": {
                "max_number": 30
            }
        },
        {
            "note": "Composites 20-60.",
            "params": {
                "max_number": 60
            }
        },
        {
            "note": "Composites 33-100, up to six primes (64, 96).",
            "params": {
                "max_number": 100
            }
        }
    ],
    "gcf": [
        {
            "note": "Numbers up to 30: short factor lists, every pair shares a factor.",
            "params": {
                "max_number": 30
            }
        },
        {
            "note": "Numbers up to 60: lists of up to twelve factors (60).",
            "params": {
                "max_number": 60
            }
        },
        {
            "note": "Numbers up to 100, with some pairs whose only common factor is 1, the way a fraction can already be in simplest form.",
            "params": {
                "max_number": 100,
                "coprime": true
            }
        }
    ],
    "decimal-add": [
        {
            "params": {
                "digits": "2,2",
                "decimal_places": 1
            }
        },
        {
            "params": {
                "digits": "2,2",
                "decimal_places": 2
            }
        }
    ],
    "decimal-subtract": [
        {
            "params": {
                "digits": "2,2",
                "decimal_places": 1
            }
        },
        {
            "params": {
                "digits": "2,2",
                "decimal_places": 2
            }
        }
    ],
    "long-divide": [
        {
            "params": {
                "digits": "2",
                "remainder": false,
                "problems": 12,
                "cols": 4
            },
            "styleParams": {
                "equation": {
                    "cols": 3
                }
            }
        },
        {
            "params": {
                "digits": "3",
                "remainder": false,
                "problems": 8,
                "cols": 4
            },
            "styleParams": {
                "equation": {
                    "cols": 3
                }
            },
            "note": "8 problems in both layouts: bracket cells (3.8 x 8.0cm) fit 4 x 2, equation cells (5.9 x 5.4cm) 3 x 3, so 8 is the most that fits one page in both."
        },
        {
            "note": "Remainder mode widens the cell to fit the answer suffix (Q r N / Q rest N). Bracket cells fit 3 x 2 = 6; the wider equation cells only 2 x 2 = 4.",
            "params": {
                "digits": "4",
                "remainder": true,
                "problems": 6,
                "cols": 3
            },
            "styleParams": {
